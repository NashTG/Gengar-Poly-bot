```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Coverage reports
.coverage
htmlcov/
coverage/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# MyPy cache
.mypy_cache/
# Pytest cache
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db
```